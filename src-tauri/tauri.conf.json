{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unmute",
  "version": "0.1.0",
  "identifier": "com.iwjong.unmute",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Unmute \u00b7 Meeting Copilot",
        "width": 480,
        "height": 320,
        "minWidth": 320,
        "minHeight": 200,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": true,
        "maximizable": false,
        "shadow": false,
        "backgroundColor": "#00000000",
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
